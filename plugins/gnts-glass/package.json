{
  "name": "gnts-glass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Glass mode for the gnts.dev desktop app — the content column on the window's vibrancy, like the sidebar.",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
