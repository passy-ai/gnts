{
  "name": "gnts-dev",
  "productName": "gnts",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop shell for the DeepSeek Harness.",
  "type": "module",
  "main": "src/main/index.mjs",
  "scripts": {
    "start": "electron .",
    "package:mac": "electron-builder --mac --config electron-builder.config.mjs",
    "package:win": "electron-builder --win --config electron-builder.config.mjs",
    "package:dir": "electron-builder --dir --config electron-builder.config.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "^1.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "dshmarket": "^1.66.16"
  },
  "devDependencies": {
    "electron": "43.0.0",
    "electron-builder": "26.15.3",
    "patch-package": "^8.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "electron@43.0.0": true,
    "node-pty@1.2.0-beta.15": true,
    "koffi@3.1.1": true,
    "protobufjs@7.6.6": true,
    "@deepseek-ai/dsh-subprocess-local@0.2.0-rc.2": true,
    "electron-winstaller@5.4.0": true,
    "@google/genai@2.21.0": true
  }
}
